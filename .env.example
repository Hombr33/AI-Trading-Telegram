# Bridge Configuration
BRIDGE_TOKEN=set-a-strong-random-token

# Telegram Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenAI Configuration
OPENAI_API_KEY=

# Database Configuration
DATABASE_URL=sqlite:///./runtime/data/trade.sqlite3

# Trading Configuration
RISK_PER_TRADE_PCT=2.0
MAX_DAILY_DRAWDOWN_PCT=6.0
MAX_DAILY_LOSS_USD=25.0

# MT5 Configuration (if using direct MT5 connection)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Crypto Exchange Configuration
# Binance
CRYPTO_BINANCE_API_KEY=
CRYPTO_BINANCE_SECRET_KEY=
CRYPTO_BINANCE_TESTNET=true

# Bybit
CRYPTO_BYBIT_API_KEY=
CRYPTO_BYBIT_SECRET_KEY=
CRYPTO_BYBIT_TESTNET=true

# Bitget
CRYPTO_BITGET_API_KEY=
CRYPTO_BITGET_SECRET_KEY=
CRYPTO_BITGET_PASSPHRASE=
CRYPTO_BITGET_TESTNET=true

# Crypto Settings
CRYPTO_DEFAULT_LEVERAGE=1
CRYPTO_MAX_LEVERAGE=10

# API Configuration
API_HOST=127.0.0.1
API_PORT=8000

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Timezone
TIMEZONE=Asia/Jakarta

# Auto Trading Configuration
AUTO_TRADING_ENABLED=false
AUTO_SIGNAL_GENERATION=false
SIGNAL_INTERVAL_MINUTES=15
MAX_TRADES_PER_DAY=10
AUTO_RISK_PER_TRADE=1.0
AUTO_FOREX_PAIRS=EURUSD,GBPUSD,USDJPY,AUDUSD
AUTO_CRYPTO_PAIRS=BTC/USDT,ETH/USDT,ADA/USDT